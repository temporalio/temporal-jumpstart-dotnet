# DataDog Configuration
# Copy this file to .env and fill in your DataDog credentials

# Required: Your DataDog API Key
# Get this from: https://app.datadoghq.com/organization-settings/api-keys
DD_API_KEY=your_datadog_api_key_here

# DataDog Site (based on your region)
# US1 (default): datadoghq.com
# US3: us3.datadoghq.com
# US5: us5.datadoghq.com
# EU: datadoghq.eu
# AP1: ap1.datadoghq.com
DD_SITE=datadoghq.com

# Optional: Hostname for your worker
DD_HOSTNAME=temporal-worker-local

# Optional: Tags to organize your metrics (comma-separated)
DD_TAGS=env:local,service:temporal-worker,team:platform

# Optional: Enable logs collection
DD_LOGS_ENABLED=false
DD_LOGS_CONFIG_CONTAINER_COLLECT_ALL=false

# Optional: Enable APM (Application Performance Monitoring)
DD_APM_ENABLED=false